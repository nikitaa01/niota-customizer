---
import { ClientRouter } from "astro:transitions";
import { messages, type Messages } from "../data/messages";
import "../styles/global.css";
import Creator from "./Creator";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const copy: Messages = messages[lang];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{copy.metaTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schoolbell&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <header class="grid h-[120px] grid-cols-[1fr_auto_1fr] items-center border-b-[3px] border-ink bg-butter px-12 max-[720px]:h-24 max-[720px]:px-3">
      <a class="block w-[29px] justify-self-start" href="https://www.instagram.com/_daniadesign/" target="_blank" rel="noreferrer">
        <img class="block h-[29px] w-[29px]" src="/icons/instagram.svg" alt="Instagram" width="29" height="29" />
      </a>
      <div class="text-center">
        <h1 class="m-0 font-display text-[40px] leading-none font-normal text-ink max-[720px]:text-[28px]">{copy.brand}</h1>
        <p class="mt-1 mb-0 font-display text-sm font-normal text-lilac">{copy.by}</p>
      </div>
      <a class="justify-self-end font-display text-sm font-normal text-lilac no-underline" href={copy.langHref}>{copy.langSwitch}</a>
    </header>
    <main>
      <h2 class="mt-14 mb-0 text-center font-display text-4xl font-normal text-lilac max-[720px]:text-[28px]">{copy.hello}</h2>
      <section class="mx-auto mt-7 flex max-w-[640px] items-center justify-center gap-6 px-6 max-[720px]:flex-col">
        <div class="w-[min(381px,100%)] text-xs leading-[1.35] [&_a]:font-medium [&_a]:no-underline">
          {
            copy.intro.map((paragraph) => (
              <p class="mt-3 mb-0 first:mt-0">
                {paragraph.map((part) => {
                  const className = [part.weight === "medium" && "font-medium", part.italic && "italic"]
                    .filter(Boolean)
                    .join(" ");
                  if (part.href) {
                    return (
                      <a href={part.href} class={className} target="_blank" rel="noreferrer">
                        {part.text}
                      </a>
                    );
                  }
                  return className ? <span class={className}>{part.text}</span> : part.text;
                })}
              </p>
            ))
          }
        </div>
        <div class="relative h-[180px] w-[180px] shrink-0 rounded-[11px] border-2 border-ink bg-[#b5e2f9]" aria-hidden="true">
          <div class="absolute top-9 left-2 h-[108.662px] w-[163.485px]">
            <img class="absolute top-[3.45px] left-[3.47px] block h-[94.476px] w-[156.941px]" src="/intro/hair.svg" alt="" width="157" height="94" />
            <img class="absolute top-[34.38px] left-[29.23px] block h-[72.11px] w-[108.578px]" src="/intro/face.svg" alt="" width="109" height="72" />
            <img class="absolute top-[63.38px] left-[53.42px] block h-[23.947px] w-[68.748px]" src="/intro/iris.svg" alt="" width="69" height="24" />
            <img class="absolute top-[63.38px] left-[44.9px] block h-[23.947px] w-[63.637px]" src="/intro/eyes.svg" alt="" width="64" height="24" />
            <div class="pointer-events-none absolute inset-0 overflow-hidden">
              <img class="absolute top-[-85.35%] left-[-100.96%] h-[284.16%] w-[251.83%] max-w-none" src="/intro/texture.png" alt="" />
            </div>
          </div>
        </div>
      </section>
      <h2 class="mt-12 mb-0 text-center font-display text-4xl font-normal text-lilac max-[720px]:text-[28px]">{copy.haveFun}</h2>
      <div class="mx-auto mt-5 mb-16 w-[min(852px,calc(100vw-32px))] overflow-hidden max-[884px]:h-[calc(540px*(100vw-32px)/852px)]">
        <div class="w-[852px] max-[884px]:origin-top-left max-[884px]:[transform:scale(calc((100vw-32px)/852px))]">
          <Creator client:load transition:persist messages={copy} />
        </div>
      </div>
    </main>
  </body>
</html>
