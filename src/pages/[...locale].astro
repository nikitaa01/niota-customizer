---
import type { GetStaticPaths } from "astro";
import Creator from "../components/Creator";
import { messages, type Messages } from "../data/messages";
import "../styles/global.css";


type Props = {
  locale: "es" | "en";
}

export const getStaticPaths: GetStaticPaths = () => {
  return [
    { params: { locale: undefined }, props: { locale: "es" } },
    { params: { locale: "en" }, props: { locale: "en" } },
  ];
}

const { locale } = Astro.props;
const copy: Messages = messages[locale];
---


<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{copy.metaTitle}</title>
    <link rel="preload" href="/fonts/schoolbell.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="text-pretty">
    <svg class="absolute size-0" aria-hidden="true">
      <filter id="text-sticker" x="-40%" y="-80%" width="180%" height="260%" color-interpolation-filters="sRGB">
        <feMorphology in="SourceAlpha" operator="dilate" radius="4" result="dilated" />
        <feGaussianBlur in="dilated" stdDeviation="3.2" result="blurred" />
        <feComponentTransfer in="blurred" result="solid">
          <feFuncA type="linear" slope="16" intercept="-2" />
        </feComponentTransfer>
        <feFlood flood-color="#ffffff" result="white" />
        <feComposite in="white" in2="solid" operator="in" result="outline" />
        <feMerge>
          <feMergeNode in="outline" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </svg>
    <header class="grid h-[120px] grid-cols-[1fr_auto_1fr] items-center border-b-[3px] border-ink bg-butter px-12 max-[720px]:h-24 max-[720px]:px-3">
      <a class="flex size-[38px] items-center justify-center justify-self-start rounded-[14px] bg-white" href="https://www.instagram.com/_daniadesign/" target="_blank" rel="noreferrer" aria-label="Instagram">
        <svg class="size-7" viewBox="0 0 448 512" fill="#70508C" aria-hidden="true">
          <path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z" />
        </svg>
      </a>
      <div class="text-center">
        <h1 class="text-sticker m-0 font-display text-[40px] leading-none font-normal text-ink max-[720px]:text-[28px]">{copy.brand}</h1>
        <p class="text-sticker mt-1 mb-0 font-display text-sm font-normal text-lilac">
          <a class="text-lilac no-underline" href="https://www.instagram.com/_daniadesign/" target="_blank" rel="noreferrer">{copy.by}</a>
        </p>
      </div>
      <a class="text-sticker inline-block justify-self-end font-display text-sm font-normal text-lilac no-underline" href={copy.langHref}>{copy.langSwitch}</a>
    </header>
    <main>
      <h2 class="mt-14 mb-0 text-center font-display text-4xl font-normal text-lilac max-[720px]:text-[28px]">{copy.hello}</h2>
      <section class="relative mx-auto mt-7 grid w-[min(748px,calc(100vw-128px))] grid-cols-[minmax(0,1fr)_180px] gap-6 max-[720px]:flex max-[720px]:flex-col">
        <div class="min-w-0 flex-1 text-xs leading-[1.35] md:text-sm [&_a]:font-medium [&_a]:no-underline">
          {
            copy.intro.map((paragraph) => (
              <p class="mt-3 mb-0 first:mt-0">
                {paragraph.map((part) => {
                  const className = [part.weight === "medium" && "font-medium", part.italic && "italic"]
                    .filter(Boolean)
                    .join(" ");
                  if (part.href) {
                    return (
                      <a href={part.href} class={className} target="_blank" rel="noreferrer">
                        {part.text}
                      </a>
                    );
                  }
                  return className ? <span class={className}>{part.text}</span> : part.text;
                })}
              </p>
            ))
          }
        </div>
        <div class="absolute top-0 right-0 bottom-0 aspect-square rounded-[11px] border-2 border-ink bg-[#b5e2f9] max-[720px]:relative max-[720px]:top-auto max-[720px]:right-auto max-[720px]:bottom-auto max-[720px]:w-full" aria-hidden="true">
          <img class="size-full object-contain" src="/intro/icono-intro.png" alt="" width="180" height="180" />
        </div>
      </section>
      <h2 class="mt-12 mb-0 text-center font-display text-4xl font-normal text-lilac max-[720px]:text-[28px]">{copy.haveFun}</h2>
      <div class="mx-auto mt-5 mb-6 w-[min(852px,calc(100vw-32px))] overflow-x-auto">
        <Creator client:load messages={copy} />
      </div>
    </main>
    <footer class="flex min-h-[64px] items-center justify-center bg-[#f0f5f8] px-4 pt-6 pb-3 text-center font-display text-xs leading-tight text-[#70508C]">
      <p class="m-0">Made with love by <a class="text-[#70508C] underline" href="https://www.instagram.com/_daniadesign/" target="_blank" rel="noreferrer">@_daniadesign</a> &lt;3</p>
    </footer>
  </body>
</html>
